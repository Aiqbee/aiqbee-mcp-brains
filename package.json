{
  "name": "aiqbee-mcp-brains",
  "displayName": "Aiqbee MCP Brains",
  "description": "Browse, visualise and manage Aiqbee knowledge brains. One-click MCP connections for Claude Code, Cursor, Windsurf and other AI coding assistants. (Public Beta)",
  "version": "0.2.2",
  "publisher": "aiqbee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiqbee/aiqbee-mcp-brains.git"
  },
  "homepage": "https://github.com/aiqbee/aiqbee-mcp-brains#readme",
  "bugs": {
    "url": "https://github.com/aiqbee/aiqbee-mcp-brains/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "aiqbee",
    "brain",
    "mcp",
    "knowledge",
    "ai",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf",
    "knowledge-base",
    "neurons"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "media/aiqbee-icon.png",
  "galleryBanner": {
    "color": "#0a0a0f",
    "theme": "dark"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiqbee-sidebar",
          "title": "Aiqbee",
          "icon": "media/aiqbee-sidebar.svg"
        }
      ]
    },
    "views": {
      "aiqbee-sidebar": [
        {
          "id": "aiqbee.serversView",
          "name": "Brains",
          "icon": "media/aiqbee-sidebar.svg",
          "contextualTitle": "Aiqbee Brains"
        },
        {
          "id": "aiqbee.brainManagerView",
          "type": "webview",
          "name": "Account & Help",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiqbee.serversView",
        "contents": "Sign in to see your brains and connect them to Claude Code, Codex, Cursor and other AI assistants.\n[Sign in to Aiqbee Cloud](command:aiqbee.signIn?%22cloud%22)\n[Add a Hive Server](command:aiqbee.addServer)\nNew to Aiqbee? [Create a free account](command:aiqbee.signUp)."
      }
    ],
    "commands": [
      {
        "command": "aiqbee.openBrainManager",
        "title": "Open Brain Manager",
        "category": "Aiqbee",
        "icon": "$(window)"
      },
      {
        "command": "aiqbee.addServer",
        "title": "Add Hive Server…",
        "category": "Aiqbee",
        "icon": "$(add)"
      },
      {
        "command": "aiqbee.renameServer",
        "title": "Rename Server…",
        "category": "Aiqbee"
      },
      {
        "command": "aiqbee.removeServer",
        "title": "Remove Server",
        "category": "Aiqbee",
        "icon": "$(trash)"
      },
      {
        "command": "aiqbee.signIn",
        "title": "Sign In",
        "category": "Aiqbee",
        "icon": "$(sign-in)"
      },
      {
        "command": "aiqbee.signOut",
        "title": "Sign Out",
        "category": "Aiqbee",
        "icon": "$(sign-out)"
      },
      {
        "command": "aiqbee.cancelSignIn",
        "title": "Cancel Sign In",
        "category": "Aiqbee",
        "icon": "$(close)"
      },
      {
        "command": "aiqbee.refresh",
        "title": "Refresh",
        "category": "Aiqbee",
        "icon": "$(refresh)"
      },
      {
        "command": "aiqbee.createBrain",
        "title": "Create Brain…",
        "category": "Aiqbee",
        "icon": "$(new-folder)"
      },
      {
        "command": "aiqbee.openBrainGraph",
        "title": "Open Brain Graph",
        "category": "Aiqbee",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "aiqbee.addMcpConnection",
        "title": "Add MCP Connection…",
        "category": "Aiqbee",
        "icon": "$(plug)"
      },
      {
        "command": "aiqbee.signUp",
        "title": "Create a Free Account",
        "category": "Aiqbee"
      },
      {
        "command": "aiqbee.openInWebApp",
        "title": "Open in Web App",
        "category": "Aiqbee",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiqbee.addServer",
          "when": "view == aiqbee.serversView",
          "group": "navigation@1"
        },
        {
          "command": "aiqbee.refresh",
          "when": "view == aiqbee.serversView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "aiqbee.signIn",
          "when": "view == aiqbee.serversView && viewItem =~ /\\.nosession/ && !(viewItem =~ /^server\\.(signingIn|unsupportedAuth)\\./)",
          "group": "inline@1"
        },
        {
          "command": "aiqbee.cancelSignIn",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\.signingIn\\./",
          "group": "inline@1"
        },
        {
          "command": "aiqbee.createBrain",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\.connected\\./",
          "group": "inline@1"
        },
        {
          "command": "aiqbee.refresh",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\./",
          "group": "inline@2"
        },
        {
          "command": "aiqbee.signIn",
          "when": "view == aiqbee.serversView && viewItem =~ /\\.nosession/ && !(viewItem =~ /^server\\.(signingIn|unsupportedAuth)\\./)",
          "group": "1_session@1"
        },
        {
          "command": "aiqbee.signOut",
          "when": "view == aiqbee.serversView && viewItem =~ /\\.session(\\.|$)/",
          "group": "1_session@2"
        },
        {
          "command": "aiqbee.createBrain",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\.connected\\./",
          "group": "2_brains@1"
        },
        {
          "command": "aiqbee.openInWebApp",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\.[a-zA-Z]+\\.cloud/",
          "group": "2_brains@2"
        },
        {
          "command": "aiqbee.renameServer",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\./",
          "group": "3_manage@1"
        },
        {
          "command": "aiqbee.removeServer",
          "when": "view == aiqbee.serversView && viewItem =~ /^server\\..*\\.removable/",
          "group": "3_manage@2"
        },
        {
          "command": "aiqbee.addMcpConnection",
          "when": "view == aiqbee.serversView && viewItem =~ /^brain\\./",
          "group": "inline@1"
        },
        {
          "command": "aiqbee.openBrainGraph",
          "when": "view == aiqbee.serversView && viewItem =~ /^brain\\./",
          "group": "1_open@1"
        },
        {
          "command": "aiqbee.addMcpConnection",
          "when": "view == aiqbee.serversView && viewItem =~ /^brain\\./",
          "group": "1_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aiqbee.renameServer",
          "when": "false"
        },
        {
          "command": "aiqbee.cancelSignIn",
          "when": "false"
        },
        {
          "command": "aiqbee.openInWebApp",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Aiqbee MCP Brains",
      "properties": {
        "aiqbee.environment": {
          "type": "string",
          "default": "production",
          "enum": [
            "development",
            "production"
          ],
          "description": "API environment to connect to."
        },
        "aiqbee.servers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "Hive Servers to add automatically. Each entry is a URL or `{ \"url\": \"…\", \"label\": \"…\" }`. Only read from user settings, never from a workspace. Servers listed here can be signed out of but not removed from the Brains view.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Hive Server address, e.g. hive.yourcompany.com"
                  },
                  "label": {
                    "type": "string",
                    "description": "Display name in the Brains view"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:prod",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "node esbuild.js",
    "compile:webview": "cd webview-ui && npm run build",
    "compile:dev": "node esbuild.js --mode=eudev && cd webview-ui && npm run build -- --mode eudev",
    "compile:prod": "node esbuild.js --mode=euprod && cd webview-ui && npm run build -- --mode euprod",
    "watch": "node esbuild.js --watch",
    "package:dev": "npm run compile:dev && vsce package",
    "package:prod": "npm run compile:prod && vsce package",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run && cd webview-ui && npx vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
